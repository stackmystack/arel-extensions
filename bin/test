#!/usr/bin/env ruby
require 'json'
require 'open3'
require 'etc'
require 'thread'
require 'fileutils'
require 'securerandom'

# --- Configuration ---

MATRIX =
  {
    "3.4" => %w[8_1 8 7_2 7_1 7 6_1],
    "3.3" => %w[8_1 8 7_2 7_1 7 6_1],
    "3.2" => %w[8_1 8 7_2 7_1 7 6_1 6],
    "3.1" => %w[7_2 7_1 7 6_1 6],
    "3.0" => %w[7_1 7 6_1 6],
    "2.7" => %w[7_1 7 6_1 6 5_2],
    "jruby-9.4" => %w[7_1 7],
    "jruby-9.3"  => %w[6_1 6 5_2],
    "jruby-9.2" => %w[6_1 6 5_2],
  }
  .transform_values { |rails_vers|
    rails_vers.map { |r|
      { rails: r, arelx: (r == '5_2' ? 1 : 2) }
    }
  }
  .freeze

# JRuby + MSSQL allowlist
JRUBY_MSSQL_ALLOWED =
  {
    "jruby-9.2" => %w[5_2],
    "jruby-9.4" => %w[7 7_1],
  }.freeze

TASKS = %w[test:to_sql test:sqlite test:mysql test:postgresql test:mssql]
# TASKS = %w[test:to_sql test:sqlite test:mysql test:postgresql test:mssql]

# Docker detection
IN_DOCKER = File.exist?('/.dockerenv') || File.exist?('/run/.containerenv')

# Use available processors, reserving 1 for system if possible
PRINT_MUTEX = Mutex.new

# Early Exit:
# 1. Configuration flag, so TODO
early_exit = false
# 2. ealy exit enforcment
stop_early = false
STOP_MUTEX = Mutex.new

# --- Helper Methods ---

# Change directory context for a block
def cd(dir)
  # puts "\e[36m$ cd #{dir}\e[0m"
  Thread.current[:dir_stack] ||= []
  Thread.current[:dir_stack].push(dir)
  begin
    yield
  ensure
    Thread.current[:dir_stack].pop
  end
  # puts "\e[36m$ cd -\e[0m"
end

# Get current directory from thread-local stack
def current_dir
  Thread.current[:dir_stack]&.last
end

def env(vars = {})
  Thread.current[:env_stack] ||= []
  Thread.current[:env_stack].push(vars)
  begin
    yield
  ensure
    Thread.current[:env_stack].pop
  end
end

# Execute shell command with optional environment variables
def sh(env_vars = {}, check: true)
  cmd = yield

  # Prepend cd if we're in a directory context
  current = current_dir
  full_cmd = if current
    "cd #{current} && #{cmd}"
  else
    cmd
  end

  # puts "\e[36m$ #{full_cmd}\e[0m"

  # Merge environment variables with inherited env
  Thread.current[:env_stack] ||= []
  merged_env =
    Thread.current[:env_stack]
      .reverse
      .reduce(ENV.to_h) { |acc, e| acc.merge(e) }
      .merge(env_vars)

  output, status = Open3.capture2e(merged_env, full_cmd)

  if check && !status.success?
    puts "\e[31m[COMMAND FAILED - OUTPUT BELOW]\e[0m"
    puts output
    puts "\e[31m[END OUTPUT]\e[0m"
    raise "Command failed (exit #{status.exitstatus}): #{cmd}"
  end

  [output, status]
end

def log(msg, color = 36)
  puts "\e[#{color}m[MATRIX] #{msg}\e[0m"
end

def skip_job?(ruby_ver, rails_ver, task)
  return false unless task =~ /mssql/ && ruby_ver.start_with?('jruby')

  allowed_rails = JRUBY_MSSQL_ALLOWED[ruby_ver]
  return true unless allowed_rails  # No entry = skip all mssql for this jruby

  !allowed_rails.include?(rails_ver)
end

def atomic_log(ruby, rails, arelx_ver, task, success, output)
  PRINT_MUTEX.synchronize do
    color = success ? 32 : 31
    status_text = success ? "SUCCESS" : "FAILURE"
    log("#{status_text}: Ruby #{ruby} | Rails #{rails} | v#{arelx_ver} | #{task}", color)

    unless success
      puts output
      puts "-" * 40
    end
  end
end

# Creates an isolated environment for the thread to run in
def prepare_workspace
  # Create a unique temp directory inside /tmp
  id = SecureRandom.hex(4)
  workspace = "/tmp/arelx_run_#{id}"
  FileUtils.mkdir_p(workspace)

  files = Dir.glob('*') - %w[.git .ruby-lsp .bundle arel_extensions.gemspec]
  FileUtils.cp_r(files, workspace)

  workspace
ensure
  # Fallback if copy fails
end

def cleanup_workspace(workspace)
  FileUtils.rm_rf(workspace) if workspace && Dir.exist?(workspace)
end

# Generates a Ruby snippet to create/drop databases without Rails tasks
def db_script_content(ruby_ver, rails_ver, adapter, action, db_name)
  # Admin connection details based on your database.yml environment defaults
  connection_config =
    case adapter
    when 'jdbc-postgresql'
      <<~CONFIG
        adapter: 'postgresql',
        database: 'postgres',
        host: ENV.fetch('POSTGRES_HOST', '127.0.0.1'),
        password: 'secret',
        port: 5432,
        username: 'postgres',
      CONFIG
    when 'postgresql'
      <<~CONFIG
        adapter: 'postgresql',
        database: 'postgres',
        host: ENV.fetch('POSTGRES_HOST', '127.0.0.1'),
        password: 'secret',
        port: 5432,
        user: 'postgres',
      CONFIG
    when 'mysql'
      <<~CONFIG
        adapter: 'mysql2',
        host: ENV.fetch('MYSQL_HOST', '127.0.0.1'),
        port: 3306,
        user: 'root',
      CONFIG
    when 'jdbc-mysql'
      <<~CONFIG
       adapter: 'jdbcmysql',
       host: ENV.fetch('MYSQL_HOST', '127.0.0.1'),
       port: 3306,
       username: 'root',
      CONFIG
    when 'sqlserver'
      <<~CONFIG
        adapter: 'sqlserver',
        host: ENV.fetch('MSSQL_HOST', 'localhost'),
        password: 'Password12!',
        username: 'sa',
      CONFIG
    else
      return nil
    end

  operation = action == :create ? "create_database('#{db_name}')" : "drop_database('#{db_name}')"
  requires =
    case ruby_ver
    when /\Ajruby-9.2/
      res = <<~RUBY
        require 'logger'
        require 'active_record'
      RUBY
      if rails_ver == '5_2'
        <<~RUBY
          #{res}
          require 'activerecord-jdbcsqlserver-adapter'
        RUBY
      else
        res
      end

    when /\Ajruby/
      <<~RUBY
        require 'logger'
        require 'active_record'
      RUBY

    else
      <<~RUBY
        require 'logger'
        require 'active_record'
        require 'activerecord-sqlserver-adapter'
      RUBY
    end


  <<~RUBY
    #{requires}

    begin
      ActiveRecord::Base.establish_connection(
        #{connection_config}
      )
      ActiveRecord::Base.connection.#{operation}
    rescue => e
      puts "DB Operation failed: \#{e.message}"
      puts ''
      puts e.backtrace
      exit(1)
    end
  RUBY
end

# --- Execution Logic ---

unless IN_DOCKER
  log "Detected Host OS. Executing inside Docker container..."
  args = ARGV.join(' ')
  exec "docker compose -f dev/compose.yaml exec arelx /app/bin/test #{args}"
end

queue = Queue.new
target_rubies = ARGV.empty? ? MATRIX.keys : MATRIX.keys.select { |k| k.start_with?(ARGV[0]) }

# Populate Queue
target_rubies.each do |ruby_ver|
  MATRIX[ruby_ver].each do |config|
    TASKS.each do |task|
      next if skip_job?(ruby_ver, config[:rails], task)
      queue << config.merge(ruby: ruby_ver, task: task)
    end
  end
end

# We need to count processors inside docker.
CPU_COUNT = [Etc.nprocessors - 1, 1].max.freeze
log "Starting Matrix Execution inside Container on #{CPU_COUNT} Threads"

workers = (1..CPU_COUNT).map do
  Thread.new do
    loop do
      # Check for early stop before pulling a new job
      STOP_MUTEX.synchronize { break if stop_early }

      begin
        job = queue.pop(true)
      rescue ThreadError
        break
      end

      workspace = nil

      begin
        ruby_ver  = job[:ruby]
        rails_ver = job[:rails]
        arelx_ver = job[:arelx]
        task      = job[:task]

        workspace = prepare_workspace

        # Determine DB strategy
        db_name = "arelx_test_#{SecureRandom.hex(4)}"
        adapter =
          case task
          when /postgresql/
            'postgresql'
          when /mysql/
            'mysql'
          when /mssql/
            'sqlserver'
          end

        adapter =
          if adapter !~ /sqlserver/ && ruby_ver.include?('jruby')
            "jdbc-#{adapter}"
          # elsif adapter =~ /sqlserver/ && ruby_ver.include?('java') && ruby_ver != 'jruby-9.4'
          #   'mssql'
          else
            adapter
          end

        top = {}.tap do |env|
          env['BUNDLE_GEMFILE'] = "./gemfiles/rails#{rails_ver}.gemfile"
          env['CLASSPATH'] = ".:mssql-jdbc-8.4.1.jre11.jar" if ruby_ver =~ /jruby/ && task =~ /mssql/
          env['_JAVA_OPTIONS'] = "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED"
        end

        cd(workspace) do
          # Step 1: Prepare workspace (gemspecs, versions, clean bundles)
          sh { "mise trust" }
          sh { "cp ./gemspecs/arel_extensions-v#{arelx_ver}.gemspec ./arel_extensions.gemspec" }
          sh { "cp ./version_v#{arelx_ver}.rb ./lib/arel_extensions/version.rb" }
          sh { "rm -rf Gemfile.lock ./gemfiles/*.lock .bundle" }

          # Step 3: Install dependencies
          env(top) do
            if adapter
              setup_script = db_script_content(ruby_ver, rails_ver, adapter, :create, db_name)
              teardown_script = db_script_content(ruby_ver, rails_ver, adapter, :drop, db_name)
              File.write(File.join(workspace, "db_create.rb"), setup_script)
              File.write(File.join(workspace, "db_drop.rb"), teardown_script)
            end

            sh { "mise x ruby@#{ruby_ver} -- bundle install --jobs=1" }

            # Step 2: Setup database if needed
            sh { "mise x ruby@#{ruby_ver} -- bundle exec ruby db_create.rb" } if adapter

            # Step 4: Run tests
            test_env = {}.tap do |env|
              env["ARELX_DATABASE"] = db_name if adapter
            end

            output, status =
              sh(test_env, check: false) {
                "mise x ruby@#{ruby_ver} -- bundle exec rake #{task}"
              }

            atomic_log(ruby_ver, rails_ver, arelx_ver, task, status.success?, output)

            # New: Trigger early stop on first failure
            if !status.success? && early_exit
              STOP_MUTEX.synchronize { stop_early = true }
            end

            # Step 5: Teardown database
            if adapter
              sh(test_env) { "mise x ruby@#{ruby_ver} -- bundle exec ruby db_drop.rb" }
            end
          end
        end
      rescue => e
        atomic_log(ruby_ver, rails_ver, arelx_ver, task, false, "Job failed: #{e.message}\n#{e.backtrace.join("\n")}")

        # New: Also trigger early stop if enabled (setup failures count as failures)
        if early_exit
          STOP_MUTEX.synchronize { stop_early = true }
        end
      ensure
        cleanup_workspace(workspace) if workspace
      end
    end
  end
end

workers.each(&:join)
log "Matrix Execution Complete", 32
