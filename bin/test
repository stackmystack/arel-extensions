#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'
require 'etc'
require 'thread'
require 'fileutils'
require 'securerandom'
require 'shellwords'
require 'optparse'
require_relative 'test-matrix'

# Schedules and executes test jobs in parallel using a work-stealing strategy.
#
# Workers pull jobs from a shared queue and execute them independently. Supports
# fail-fast mode to stop on first failure and configurable thread count.
class Scheduler
  attr_reader :log

  # Initialize a new job scheduler with standard logging.
  #
  # @param filter [String, nil] Ruby version prefix to filter jobs
  # @param fail_fast [Boolean] stop on first failure
  # @param threads [Integer, nil] number of worker threads (defaults to CPU count - 1)
  # @param container [Boolean, nil] whether to run in container (nil means not explicitly set)
  def initialize(filter: nil, fail_fast: false, threads: nil, container: nil, log: nil)
    @filter = filter
    @fail_fast = fail_fast
    @threads = threads || [Etc.nprocessors - 1, 1].max
    @container = container
    @stop_mutex = Mutex.new
    @stop_early = false
    @log = log || ExecLogger.new
  end

  # Execute all jobs using work-stealing scheduler.
  #
  # @return [void]
  def run
    jobs = Matrix.jobs(filter: @filter)

    queue = Queue.new
    jobs.each { |job| queue << job }
    nworkers = [jobs.size, @threads].min

    log.msg "Running #{jobs.size} job#{jobs.size != 1 ? 's' : ''} with #{nworkers} workers"

    workers = spawn(queue, nworkers)
    workers.each(&:join)

    log.msg "Matrix Execution Complete"
  end

  private

  # Spawn worker threads that pull jobs from the queue.
  #
  # @param queue [Queue] thread-safe queue of jobs
  # @return [Array<Thread>] array of worker threads
  def spawn(queue, nworkers)
    (1..nworkers).map do
      Thread.new do
        loop do
          # Check for early stop before pulling a new job
          @stop_mutex.synchronize { break if @stop_early }

          begin
            job = queue.pop(true)
          rescue ThreadError
            break
          end

          success = execute(job)

          # Handle fail-fast mode
          if !success && @fail_fast
            @stop_mutex.synchronize { @stop_early = true }
          end
        end
      end
    end
  end

  # Execute a single job by delegating to test-tuple.
  #
  # @param job [Hash] job hash with :ruby, :rails, :arelx, :task keys
  # @return [Boolean] true if job succeeded, false otherwise
  def execute(job)
    flags = job.flat_map { |k, v| ["--#{k}", v.to_s] }
    flags << "--no-container" if !@container

    output, status = Open3.capture2e("./bin/test-tuple", *flags)

    log.job(job, status.success?, output)
    status.success?
  end
end

# --- Argument Parsing ---
log = ExecLogger.new
options = { container: true }

parser = OptionParser.new do |opts|
  opts.banner = "Usage: #{$0} [OPTIONS] [FILTER_ARG ...]"

  opts.separator ""
  opts.separator "FILTER EXAMPLES (pass each filter as separate argument):"
  opts.separator "  #{$0}                              # All jobs"
  opts.separator "  #{$0} ruby:3.2                     # Exact: Ruby 3.2"
  opts.separator "  #{$0} ruby:3:                      # Prefix: All Ruby 3.x (3.0, 3.1, 3.2, ...)"
  opts.separator "  #{$0} ruby:3.0:3.3                 # Range: Ruby 3.0 to 3.3 (inclusive)"
  opts.separator "  #{$0} ruby:!3.2                    # Negated exact: All except Ruby 3.2"
  opts.separator "  #{$0} ruby:!3:                     # Negated prefix: All except 3.x"
  opts.separator "  #{$0} ruby:!3.0:3.3                # Negated range: All except 3.0-3.3"
  opts.separator "  #{$0} ruby:3: rails:8              # Combined: Ruby 3.x + Rails 8"
  opts.separator "  #{$0} task:postgresql              # Task shorthand (→ task:test:postgresql)"
  opts.separator "  #{$0} test:sqlite                  # Test shorthand (→ task:test:sqlite)"
  opts.separator "  #{$0} jruby:9.4                    # JRuby shorthand (→ ruby:jruby-9.4)"
  opts.separator ""
  opts.separator "FILTER DIMENSIONS:"
  opts.separator "  ruby:<spec>      - By Ruby version (exact, prefix:, range:to, or negated with !)"
  opts.separator "  jruby:<version>  - Shorthand for ruby:jruby-<version>"
  opts.separator "  rails:<spec>     - By Rails version (same syntax as ruby)"
  opts.separator "  arelx:<spec>     - By ArelExtensions version (same syntax as ruby)"
  opts.separator "  task:<task>      - By test task (e.g., task:postgresql, task:test:sqlite)"
  opts.separator "  test:<task>      - Shorthand for task:test:<task>"
  opts.separator ""
  opts.separator "VERSION SYNTAX (for ruby, rails, arelx):"
  opts.separator "  3.2              - Exact match: 3.2"
  opts.separator "  3:               - Prefix match: all versions starting with 3"
  opts.separator "  3:3.3            - Range match: 3 to 3.3 (inclusive on both ends)"
  opts.separator "  !3.2             - Negated exact: everything except 3.2"
  opts.separator "  !3:              - Negated prefix: everything except 3.x"
  opts.separator "  !3:3.3           - Negated range: everything except 3 to 3.3"
  opts.separator ""
  opts.separator "NOTES:"
  opts.separator "  Each argument can contain multiple space-separated filters"
  opts.separator "  All filters must match for a job to be included (AND logic)"
  opts.separator "  Task/test shorthands are normalized: test:postgresql → task:test:postgresql"
  opts.separator "   - test:postgresql → task:test:postgresql"
  opts.separator "   - test:pg and test:postgres → task:test:postgresql"
  opts.separator "   - test:my → task:test:mysql"
  opts.separator "  JRuby shorthand is normalized: jruby:9.4 → ruby:jruby-9.4"
  opts.separator ""

  opts.on("--fail-fast", "Stop on first failure") do
    options[:fail_fast] = true
  end

  opts.on("--threads N", Integer, "Number of parallel worker threads") do |n|
    options[:threads] = n
  end

  opts.on("--[no-]container", "Run inside Docker container (default: true)") do |v|
    options[:container] = v
  end

  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit(0)
  end
end

begin
  parser.parse!(ARGV)
rescue OptionParser::ParseError => e
  log.error "Option parsing failed: #{e.class}"
  log.error e.message
  puts parser.help
  exit 1
end

options[:filter] = ARGV if ARGV.any?

# --- Execution ---

if options[:container] && !in_container?
  container_exec(log:)
end

scheduler = Scheduler.new(**options, log:)
scheduler.run
