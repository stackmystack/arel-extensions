#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'
require 'etc'
require 'thread'
require 'fileutils'
require 'securerandom'
require 'shellwords'
require 'optparse'
require 'logger'

# Executes a single test job in an isolated workspace with database setup/teardown.
#
# Creates a temporary workspace, installs dependencies for the specified Ruby/Rails/ArelExtensions
# version combination, runs the test task, and cleans up resources.
#
# @example Execute a PostgreSQL test
#   executor = ExecTestTuple.new(ruby: "3.2", rails: "7.1", arelx: 2, task: "test:postgresql")
#   exit_code = executor.execute
#
# @example Execute a SQLite test
#   executor = ExecTestTuple.new(ruby: "3.3", rails: "8", arelx: 2, task: "test:sqlite")
#   exit_code = executor.execute
class ExecTestTuple
  # Exit code for successful test execution
  EXIT_SUCCESS = 0
  # Exit code for failed test execution
  EXIT_FAILURE = 1

  # Initialize a new job executor.
  #
  # @param ruby [String] Ruby version (e.g., "3.2", "jruby-9.4")
  # @param rails [String] Rails version (e.g., "7.1", "8")
  # @param arelx [Integer] ArelExtensions version (1 or 2)
  # @param task [String] Rake task to execute (e.g., "test:postgresql", "test:mysql")
  def initialize(ruby:, rails:, arelx:, task:)
    @ruby = ruby
    @rails = rails
    @arelx = arelx
    @task = task
    @dir_stack = []
    @env_stack = []
    @workspace = nil
    @log = Logger.new($stdout)
  end

  attr_reader :log

  # Execute the test job.
  #
  # Creates an isolated workspace, configures the environment, installs dependencies,
  # sets up the database (if needed), runs the test task, tears down the database,
  # and cleans up the workspace.
  #
  # @return [Integer] EXIT_SUCCESS (0) if tests pass, EXIT_FAILURE (1) if tests fail or error occurs
  def execute
    @workspace = prepare_workspace
    db_name = "arelx_test_#{SecureRandom.hex(4)}"
    needs_isolated_db = @task.match?(/mssql|mysql|postgresql/)

    top = {}.tap do |env|
      env['BUNDLE_GEMFILE'] = "./gemfiles/rails#{@rails}.gemfile"
      env['CLASSPATH'] = ".:mssql-jdbc-8.4.1.jre11.jar" if @ruby =~ /jruby/ && @task =~ /mssql/
      env['_JAVA_OPTIONS'] = "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED"
    end

    cd(@workspace) do
      # Step 1: Prepare workspace (gemspecs, versions, clean bundles)
      sh { "mise trust" }
      sh { "cp ./gemspecs/arel_extensions-v#{@arelx}.gemspec ./arel_extensions.gemspec" }
      sh { "cp ./version_v#{@arelx}.rb ./lib/arel_extensions/version.rb" }
      sh { "rm -rf Gemfile.lock ./gemfiles/*.lock .bundle" }

      # Step 2: Install dependencies
      env(top) do
        sh { "mise x ruby@#{@ruby} -- bundle install" }

        # Step 3: Setup database if needed
        if needs_isolated_db
          execute_db_script(:create, db_name)
        end

        # Step 4: Run tests
        test = {}.tap do |env|
          env["ARELX_DATABASE"] = db_name if needs_isolated_db
        end

        env(test) do
          status = sh(fail: false) { "mise x ruby@#{@ruby} -- bundle exec rake #{@task}" }

          # Step 5: Teardown database
          if needs_isolated_db
            execute_db_script(:drop, db_name)
          end

          # Return based on test result
          return status.success? ? EXIT_SUCCESS : EXIT_FAILURE
        end
      end
    end

  rescue => e
    STDERR.puts "Job failed: #{e.message}\n#{e.backtrace.join("\n")}"
    return EXIT_FAILURE
  ensure
    cleanup_workspace if @workspace
  end

  private

  # Execute a block within a directory context.
  #
  # Maintains a stack of directory contexts for nested calls. The directory is prepended
  # to shell commands executed within the block.
  #
  # @param dir [String] directory path
  # @yield block to execute in the directory context
  # @return [Object] result of the block
  def cd(dir)
    @dir_stack.push(dir)
    begin
      yield
    ensure
      @dir_stack.pop
    end
  end

  # Get the current directory context.
  #
  # @return [String, nil] current directory from the stack, or nil if none
  def current_dir
    @dir_stack.last
  end

  # Execute a block with additional environment variables.
  #
  # Maintains a stack of environment contexts for nested calls. Variables are merged
  # with parent contexts and system environment when executing shell commands.
  #
  # @param vars [Hash<String, String>] environment variables to add
  # @yield block to execute with the environment context
  # @return [Object] result of the block
  def env(vars = {})
    @env_stack.push(vars)
    begin
      yield
    ensure
      @env_stack.pop
    end
  end

  # Execute a shell command with merged environment and directory context.
  #
  # Combines environment variables from the env stack with provided vars, and prepends
  # the current directory (if any) to the command.
  #
  # @param env_vars [Hash<String, String>] additional environment variables
  # @param fail [Boolean] whether to raise on command failure
  # @yield command string to execute
  # @return [Array<(String, Process::Status)>] command output and process status
  # @raise [RuntimeError] if command fails and `fail` is true
  def sh(env_vars = {}, fail: true)
    cmd = yield

    # Prepend cd if we're in a directory context
    current = current_dir
    full_cmd = if current
      "cd #{current} && #{cmd}"
    else
      cmd
    end

    # Merge environment variables with inherited env
    merged_env =
      @env_stack
        .reverse
        .reduce(ENV.to_h) { |acc, e| acc.merge(e) }
        .merge(env_vars)

    output, status = Open3.capture2e(merged_env, full_cmd)

    if !status.success?
      log.error "[COMMAND FAILED - OUTPUT BELOW]"
      log.error output
      log.error "[END OUTPUT]"

      raise "Command failed (exit #{status.exitstatus}): #{cmd}" if fail
    end

    status
  end

  # Create an isolated workspace for the job.
  #
  # Copies project files to a unique temporary directory under /tmp, excluding
  # build artifacts and IDE configurations.
  #
  # @return [String] path to the workspace directory
  def prepare_workspace
    # Create a unique temp directory inside /tmp
    id = SecureRandom.hex(4)
    workspace = "/tmp/arelx_run_#{id}"
    FileUtils.mkdir_p(workspace)

    files = Dir.glob('*') - %w[.ruby-lsp .bundle arel_extensions.gemspec]
    FileUtils.cp_r(files, workspace)

    workspace
  end

  # Remove the workspace directory and its contents.
  #
  # @return [void]
  def cleanup_workspace
    FileUtils.rm_rf(@workspace) if @workspace && Dir.exist?(@workspace)
  end

  # Determine the database setup script path based on the task.
  #
  # @return [String, nil] path to the setup script, or nil for tasks without database setup
  def db_setup_script_for_task
    case @task
    when /postgresql/ then 'test/db_setup_postgresql.rb'
    when /mysql/      then 'test/db_setup_mysql.rb'
    when /mssql/      then 'test/db_setup_mssql.rb'
    end
  end

  # Execute database setup or teardown script.
  #
  # Runs the appropriate database script with environment variables for the database name,
  # action, Ruby version, and Rails version.
  #
  # @param action [Symbol] :create to setup database, :drop to teardown
  # @param db_name [String] unique database name for this job
  # @return [void]
  def execute_db_script(action, db_name)
    script = db_setup_script_for_task
    return if script.nil?

    action_str = action == :create ? 'create' : 'drop'
    env_vars = {
      'ARELX_DB_ACTION' => action_str,
      'ARELX_DB_NAME' => db_name,
      'RUBY_VERSION' => @ruby,
      'RAILS_VERSION' => @rails,
    }

    sh(env_vars) { "mise x ruby@#{@ruby} -- bundle exec ruby #{script}" }
  end
end

# --- Argument Parsing ---

# Preserve original arguments before parser modifies ARGV
ARGVDUP = ARGV.dup.freeze
options = { container: true }

parser = OptionParser.new do |opts|
  opts.banner = "Usage: #{$0} [OPTIONS] or #{$0} <ruby,rails,arelx,task>"

  opts.on("--ruby RUBY", "Ruby version") do |v|
    options[:ruby] = v
  end

  opts.on("--rails RAILS", "Rails version") do |v|
    options[:rails] = v
  end

  opts.on("--arelx ARELX", "Arel Extensions version") do |v|
    options[:arelx] = v
  end

  opts.on("--task TASK", "Task to run") do |v|
    options[:task] = v
  end

  opts.on("--[no-]container", "Run inside Docker container (default: true)") do |v|
    options[:container] = v
  end

  opts.on("-h", "--help", "Prints this help") do
    puts opts
    exit(ExecTestTuple::EXIT_SUCCESS)
  end
end

parser.parse!

# --- Docker Detection ---

IN_DOCKER = File.exist?('/.dockerenv') || File.exist?('/run/.containerenv')

if options[:container] && !IN_DOCKER
  puts "Detected Host OS. Executing inside Docker container..."

  # Filter out container-related flags from original args
  args = ARGVDUP.reject { it.match?(/\A--(?:no-)?container\z/) }.join(' ')

  exec "docker compose -f dev/compose.yaml exec arelx /app/bin/test-tuple #{args}"
end

# Check if we have flags or CSV positional argument
if options.any? { |k, v| !k.end_with?('container') && v }
  # Using flags - all must be present
  if !(options[:ruby] && options[:rails] && options[:arelx] && options[:task])
    puts "original_args = #{args}"
    puts "options = #{options}"
    STDERR.puts "Error: All options (--ruby, --rails, --arelx, --task) must be provided"
    STDERR.puts parser.help
    exit(ExecTestTuple::EXIT_FAILURE)
  end

  if ARGV.any?
    STDERR.puts "Error: Cannot use both options and positional arguments"
    STDERR.puts parser.help
    exit(ExecTestTuple::EXIT_FAILURE)
  end

  ruby = options[:ruby]
  rails = options[:rails]
  arelx = options[:arelx]
  task = options[:task]
elsif ARGV.length == 1
  # Using CSV positional argument
  parts = ARGV[0].split(',')
  if parts.length != 4
    STDERR.puts "Error: CSV must have exactly 4 values: ruby,rails,arelx,task"
    exit(ExecTestTuple::EXIT_FAILURE)
  end

  ruby, rails, arelx, task = parts
else
  STDERR.puts "Error: Provide either all options or a single CSV argument"
  STDERR.puts parser.help
  exit(ExecTestTuple::EXIT_FAILURE)
end

# --- Execution ---

executor = ExecTestTuple.new(ruby: ruby, rails: rails, arelx: arelx.to_i, task: task)
exit(executor.execute)
